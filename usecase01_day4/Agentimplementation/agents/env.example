# Template only. Copy this file to .env, or let setup.sh write .env for you.
# Never commit a filled .env: it names your project and your region.
#
# Replace every value in angle brackets with your own.

# Use Vertex AI (your Google Cloud project) rather than a personal API key.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
 
# Your Google Cloud project ID.
# Example: my-team-agents-dev
GOOGLE_CLOUD_PROJECT=bdc-tred-fde-shared
 
# The region the model is called in.
# Example: us-central1
GOOGLE_CLOUD_LOCATION=us-central1
 
 
# The Gemini model the agents run on.
AGENT_MODEL=gemini-2.5-flash
